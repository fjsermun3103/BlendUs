# Never bake local secrets or machine state into the image
.env
.env.*
!.env.example
vendor/
node_modules/
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*
# Symlink created by `storage:link` in dev; start-hf.sh recreates it inside the container
public/storage
bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache/
