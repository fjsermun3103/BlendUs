# Production image for the BlendUs frontend (used by docker-compose.prod.yml):
# compiles the site once and serves it with Astro's standalone Node server (no dev server, no HMR).

FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Empty PUBLIC_API_URL => the browser calls /api/... on the same origin; Caddy forwards it to Laravel.
# That keeps the build valid for any public URL (including random trycloudflare.com ones).
ARG PUBLIC_API_URL=""
ENV PUBLIC_API_URL=$PUBLIC_API_URL
RUN ASTRO_ADAPTER=node npm run build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
EXPOSE 4321
CMD ["node", "./dist/server/entry.mjs"]
