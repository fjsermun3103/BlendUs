# Copy to .env.prod on the server (never commit .env.prod) and fill in the values.
#   cp .env.prod.example .env.prod

# Laravel encryption key. Generate one with:
#   docker run --rm php:8.2-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Database password (any long random string, e.g. `openssl rand -hex 24`)
DB_PASSWORD=

# Public URL of the demo. With the "quick" profile, paste the trycloudflare.com URL here once you know it
# (only used for Stripe redirect URLs and links generated outside a request).
PUBLIC_URL=http://localhost:8080

# Named Cloudflare Tunnel token (only for the "tunnel" profile, i.e. your own domain)
CLOUDFLARE_TUNNEL_TOKEN=

# Stripe TEST keys (optional). Leave empty to disable checkout.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
